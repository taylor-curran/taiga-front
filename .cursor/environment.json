{
  "$schema": "https://www.cursor.com/schemas/environment.schema.json",
  "name": "taiga-front-cloud",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "bash .cursor/scripts/install.sh",
  "ports": [
    { "name": "Taiga gateway (reference)", "port": 9000 },
    { "name": "React app",                 "port": 5173 }
  ],
  "start": "bash .cursor/scripts/start.sh",
  "terminals": [
    { "name": "taiga", "command": "npm run taiga-up && npm run taiga-seed && npm run taiga-logs" },
    { "name": "react", "command": "npm run react" }
  ]
}
