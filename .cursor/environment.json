{
  "$schema": "https://www.cursor.com/schemas/environment.schema.json",
  "name": "taiga-front-cloud",
  "install": "bash scripts/cursor-cloud-install.sh",
  "ports": [
    { "name": "Taiga gateway", "port": 9000 },
    { "name": "React app",     "port": 5173 }
  ],
  "start": "true",
  "terminals": [
    { "name": "dockerd", "command": "bash scripts/cursor-cloud-dockerd.sh" },
    { "name": "taiga", "command": "bash scripts/cursor-cloud-taiga.sh" },
    { "name": "react", "command": "if [ -s \"$HOME/.nvm/nvm.sh\" ]; then . \"$HOME/.nvm/nvm.sh\"; nvm use 22; fi; npm run react" }
  ]
}
